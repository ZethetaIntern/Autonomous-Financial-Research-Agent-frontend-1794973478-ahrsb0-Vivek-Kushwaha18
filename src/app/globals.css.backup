@import "tailwindcss";

:root {
  --bg: #080b14;
  --sidebar: #0c1020;
  --surface: #111729;
  --surface-raised: #151d32;
  --surface-hover: #1a2440;
  --border: #252e46;
  --border-soft: #1c263c;
  --text: #eef1fb;
  --muted: #929bb3;
  --subtle: #66718c;
  --accent: #8870f5;
  --accent-bright: #a18eff;
  --accent-soft: rgba(136, 112, 245, .13);
  --green: #36c99a;
  --amber: #eab96a;
  --red: #f17d8b;
  --blue: #65a9f7;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: var(--accent-bright);
  text-decoration: none;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 75% -20%, rgba(94, 75, 190, .12), transparent 38%),
    var(--bg);
}

.sidebar {
  width: 258px;
  min-width: 258px;
  min-height: 100vh;
  padding: 25px 17px 18px;
  display: flex;
  flex-direction: column;
  background: var(--sidebar);
  border-right: 1px solid var(--border-soft);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 2px 9px 29px;
  color: var(--text);
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  border-radius: 11px;
  color: white;
  font-size: 23px;
  font-weight: 800;
  background: linear-gradient(145deg, #a18aff, #6247d5);
  box-shadow: 0 5px 22px rgba(119, 91, 230, .28);
}

.brand strong {
  display: block;
  font-size: 19px;
  letter-spacing: -.7px;
  font-weight: 750;
}

.brand small {
  display: block;
  margin-top: 4px;
  color: var(--subtle);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.55px;
}

.side-label {
  padding: 10px 11px;
  color: #707c98;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.35px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 43px;
  margin: 2px 0;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #a9b2c8;
  text-align: left;
  font-size: 12px;
  font-weight: 550;
  transition: .18s ease;
}

.nav-item:hover {
  color: white;
  background: var(--surface);
}

.nav-item.active {
  color: #c4b8ff;
  background: var(--accent-soft);
  border-color: rgba(136, 112, 245, .19);
}

.nav-icon {
  width: 19px;
  color: var(--accent-bright);
  text-align: center;
  font-size: 17px;
}

.history-label {
  margin-top: 27px;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
  overflow-y: auto;
  max-height: 43vh;
}

.empty-history {
  padding: 0 11px;
  color: var(--subtle);
  font-size: 11px;
  line-height: 1.7;
}

.history-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  width: 100%;
  padding: 11px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #aeb7ca;
  text-align: left;
}

.history-item:hover,
.history-item.selected {
  background: var(--surface);
  border-color: var(--border);
}

.history-title {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 11px;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 22px;
}

.connection-card {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 11px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface);
}

.connection-dot,
.live-indicator i {
  width: 8px;
  height: 8px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--amber);
}

.connection-dot.online,
.live-indicator i {
  background: var(--green);
  box-shadow: 0 0 11px rgba(54, 201, 154, .35);
}

.connection-dot.offline {
  background: var(--red);
  box-shadow: none;
}

.connection-card strong,
.connection-card small {
  display: block;
}

.connection-card strong {
  font-size: 11px;
}

.connection-card small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 10px;
}

.version-label {
  display: block;
  padding: 17px 3px 0;
  color: var(--subtle);
  font-size: 9px;
}

.main-area {
  min-width: 0;
  flex: 1;
}

.topbar {
  height: 67px;
  padding: 0 37px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-soft);
  background: rgba(12, 16, 32, .82);
}

.breadcrumb {
  color: var(--muted);
  font-size: 11px;
}

.breadcrumb span {
  padding: 0 9px;
  color: var(--subtle);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 23px;
}

.live-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #aab5ca;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 1px;
}

.live-indicator i {
  display: inline-block;
  width: 7px;
  height: 7px;
}

.avatar {
  display: grid;
  place-items: center;
  width: 33px;
  height: 33px;
  border: 1px solid #51448a;
  border-radius: 50%;
  background: #211b3b;
  color: #c9bcff;
  font-size: 10px;
  font-weight: 750;
}

.content {
  width: 100%;
  max-width: 1600px;
  margin: auto;
  padding: 36px 38px 24px;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 27px;
}

.eyebrow {
  margin-bottom: 10px;
  color: var(--accent-bright);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.65px;
}

.page-heading h1 {
  margin: 0;
  color: #f2f3fc;
  font-size: clamp(24px, 2.5vw, 31px);
  font-weight: 650;
  letter-spacing: -1.1px;
}

.page-heading p {
  max-width: 650px;
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.date-chip {
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: var(--surface);
  color: #b4bdd1;
  white-space: nowrap;
  font-size: 10px;
}

.date-chip span {
  margin-right: 7px;
  color: var(--accent-bright);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 19px;
}

.stat-card,
.panel {
  border: 1px solid var(--border);
  border-radius: 10px;
  background: linear-gradient(145deg, #131b2e, #101626);
  box-shadow: 0 8px 30px rgba(0, 0, 0, .10);
}

.stat-card {
  min-height: 115px;
  padding: 17px 18px;
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 10px;
}

.stat-symbol {
  color: var(--accent-bright);
  font-size: 16px;
}

.stat-symbol.green {
  color: var(--green);
}

.stat-symbol.blue {
  color: var(--blue);
}

.stat-symbol.amber {
  color: var(--amber);
}

.stat-card > strong {
  display: block;
  margin-top: 12px;
  color: #f2f3fc;
  font-size: 27px;
  font-weight: 650;
  letter-spacing: -.8px;
  font-variant-numeric: tabular-nums;
}

.stat-card > small {
  display: block;
  margin-top: 5px;
  color: var(--subtle);
  font-size: 9px;
}

.research-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
  gap: 16px;
  margin-bottom: 18px;
  align-items: stretch;
}

.panel {
  min-width: 0;
  padding: 21px;
}

.panel-heading,
.results-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.panel-heading h2,
.results-heading h2 {
  margin: 0;
  color: #edf0fa;
  font-size: 16px;
  font-weight: 650;
  letter-spacing: -.25px;
}

.panel-heading .eyebrow,
.results-heading .eyebrow {
  margin-bottom: 7px;
}

.panel-icon {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  border: 1px solid rgba(136, 112, 245, .23);
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent-bright);
  font-size: 17px;
}

.panel-description {
  margin: 13px 0 21px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

.new-research-panel form {
  display: flex;
  flex-direction: column;
}

.new-research-panel label {
  margin: 0 0 8px;
  color: #c4cce0;
  font-size: 10px;
  font-weight: 650;
}

.new-research-panel input,
.new-research-panel textarea {
  width: 100%;
  margin-bottom: 17px;
  padding: 12px 13px;
  border: 1px solid #303b57;
  border-radius: 7px;
  outline: none;
  background: #0b1120;
  color: var(--text);
  font-size: 11px;
  line-height: 1.7;
  transition: border-color .18s, box-shadow .18s;
}

.new-research-panel input {
  min-height: 42px;
}

.new-research-panel textarea {
  min-height: 125px;
  resize: vertical;
}

.new-research-panel input::placeholder,
.new-research-panel textarea::placeholder {
  color: #68748e;
}

.new-research-panel input:focus,
.new-research-panel textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(136, 112, 245, .11);
}

.input-footer {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: -8px;
  margin-bottom: 17px;
  color: var(--subtle);
  font-size: 9px;
}

.primary-button {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  min-height: 44px;
  padding: 0 16px;
  border: 1px solid #9079fa;
  border-radius: 7px;
  background: linear-gradient(105deg, #7257dc, #8c70f4);
  color: white;
  font-size: 11px;
  font-weight: 750;
  box-shadow: 0 5px 20px rgba(113, 84, 219, .18);
  transition: .2s ease;
}

.primary-button:hover:not(:disabled) {
  filter: brightness(1.12);
  transform: translateY(-1px);
  box-shadow: 0 8px 25px rgba(113, 84, 219, .28);
}

.primary-button:disabled {
  cursor: wait;
  opacity: .65;
}

.primary-button span {
  margin-left: auto;
  font-size: 17px;
}

.source-note {
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1px solid var(--border-soft);
}

.source-note > strong {
  display: block;
  margin-bottom: 11px;
  color: #c0c9dd;
  font-size: 10px;
}

.source-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.source-tags span {
  padding: 6px 8px;
  border: 1px solid #2b3550;
  border-radius: 5px;
  background: #151d31;
  color: #9eabc5;
  font-size: 9px;
}

.status {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 5px 8px;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: #1a2235;
  color: #aab6cf;
  font-size: 9px;
  font-weight: 750;
  text-transform: capitalize;
}

.status.completed {
  border-color: rgba(54, 201, 154, .25);
  background: rgba(54, 201, 154, .09);
  color: var(--green);
}

.status.partial {
  border-color: rgba(234, 185, 106, .25);
  background: rgba(234, 185, 106, .09);
  color: var(--amber);
}

.status.failed {
  border-color: rgba(241, 125, 139, .25);
  background: rgba(241, 125, 139, .09);
  color: var(--red);
}

.status.running {
  border-color: rgba(101, 169, 247, .25);
  background: rgba(101, 169, 247, .09);
  color: var(--blue);
}

.status.queued {
  color: #aab6cf;
}

.empty-state {
  min-height: 340px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 25px;
  text-align: center;
}

.empty-icon {
  display: grid;
  place-items: center;
  width: 55px;
  height: 55px;
  margin-bottom: 15px;
  border: 1px solid #40366b;
  border-radius: 15px;
  background: var(--accent-soft);
  color: var(--accent-bright);
  font-size: 27px;
}

.empty-state h3 {
  margin: 0;
  color: #e3e8f6;
  font-size: 14px;
}

.empty-state p {
  max-width: 260px;
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.8;
}

.selected-company {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 23px;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0c1323;
}

.company-avatar {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  border: 1px solid #51448a;
  border-radius: 9px;
  background: #211b3b;
  color: #c6b9ff;
  font-size: 16px;
  font-weight: 750;
}

.selected-company strong,
.selected-company small {
  display: block;
}

.selected-company strong {
  color: #e9edfa;
  font-size: 12px;
}

.selected-company small {
  margin-top: 5px;
  color: var(--muted);
  font-size: 9px;
}

.research-question {
  margin-top: 17px;
  padding: 13px;
  border-left: 2px solid var(--accent);
  background: rgba(136, 112, 245, .055);
}

.research-question small,
.overview-grid small {
  color: var(--accent-bright);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1px;
}

.research-question p {
  margin: 8px 0 0;
  color: #c0c9dc;
  font-size: 10px;
  line-height: 1.8;
}

.execution-timeline {
  margin: 21px 0;
}

.timeline-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-height: 54px;
}

.timeline-row:not(:last-child)::after {
  position: absolute;
  top: 24px;
  left: 10px;
  width: 1px;
  height: 29px;
  background: #35405b;
  content: "";
}

.timeline-dot {
  z-index: 1;
  display: grid;
  place-items: center;
  width: 21px;
  height: 21px;
  flex-shrink: 0;
  border: 1px solid #39445f;
  border-radius: 50%;
  background: #171f33;
  color: #8c98b2;
  font-size: 9px;
}

.timeline-dot.done {
  border-color: rgba(54, 201, 154, .3);
  background: rgba(54, 201, 154, .12);
  color: var(--green);
}

.timeline-row strong,
.timeline-row small {
  display: block;
}

.timeline-row strong {
  padding-top: 2px;
  color: #dce2f1;
  font-size: 10px;
}

.timeline-row small {
  margin-top: 5px;
  color: var(--subtle);
  font-size: 9px;
}

.execution-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 14px 0 3px;
  border-top: 1px solid var(--border-soft);
}

.execution-metrics > div {
  text-align: center;
}

.execution-metrics > div + div {
  border-left: 1px solid var(--border);
}

.execution-metrics strong,
.execution-metrics small {
  display: block;
}

.execution-metrics strong {
  color: #f0f1fa;
  font-size: 18px;
}

.execution-metrics small {
  margin-top: 5px;
  color: var(--muted);
  font-size: 9px;
}

.polling-note {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 16px;
  color: var(--blue);
  font-size: 9px;
}

.spinner {
  width: 12px;
  height: 12px;
  border: 2px solid #34445e;
  border-top-color: var(--blue);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-message {
  margin: 10px 0;
  padding: 11px 12px;
  border: 1px solid rgba(241, 125, 139, .3);
  border-radius: 6px;
  background: rgba(241, 125, 139, .08);
  color: #ff9ba6;
  font-size: 10px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.results-panel {
  margin-bottom: 20px;
  padding: 22px;
}

.results-heading {
  margin-bottom: 20px;
}

.download-button {
  padding: 9px 13px;
  border: 1px solid #51448a;
  border-radius: 6px;
  background: var(--accent-soft);
  color: #c4b7ff;
  font-size: 10px;
  font-weight: 700;
}

.download-button:hover {
  background: rgba(136, 112, 245, .22);
}

.tabs {
  display: flex;
  gap: 24px;
  min-height: 43px;
  border-bottom: 1px solid var(--border);
}

.tab {
  position: relative;
  padding: 0 2px;
  border: 0;
  background: transparent;
  color: #8490aa;
  font-size: 10px;
  font-weight: 650;
}

.tab:hover {
  color: white;
}

.tab.active-tab {
  color: #c3b5ff;
}

.tab.active-tab::after {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 2px;
  background: var(--accent);
  content: "";
}

.results-empty {
  display: grid;
  place-items: center;
  min-height: 190px;
  padding: 25px;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

.overview-content {
  padding-top: 20px;
}

.overview-message {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0c1323;
}

.overview-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent-bright);
  font-size: 17px;
}

.overview-message h3 {
  margin: 1px 0 7px;
  color: #e8ecf8;
  font-size: 12px;
}

.overview-message p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.8;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 15px;
}

.overview-grid > div {
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: #0d1424;
  min-width: 0;
}

.overview-grid small,
.overview-grid strong {
  display: block;
}

.overview-grid strong {
  margin-top: 9px;
  overflow-wrap: anywhere;
  color: #e1e7f6;
  font-size: 11px;
  font-weight: 650;
  text-transform: capitalize;
}

.report-content {
  padding-top: 21px;
}

.report-title {
  margin-bottom: 17px;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0c1323;
}

.report-title > span {
  color: var(--accent-bright);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.report-title h3 {
  margin: 9px 0;
  color: #eef0fa;
  font-size: 17px;
}

.report-title small {
  color: var(--muted);
  font-size: 9px;
}

.report-content pre {
  max-height: 850px;
  overflow: auto;
  margin: 0;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0b1120;
  color: #c6cee0;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  line-height: 1.9;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 17px;
}

.evidence-card {
  display: flex;
  gap: 15px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0d1424;
}

.evidence-number {
  color: #7565bb;
  font-size: 12px;
  font-weight: 750;
}

.evidence-body {
  min-width: 0;
  flex: 1;
}

.evidence-type {
  color: var(--accent-bright);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.evidence-body h3 {
  margin: 7px 0;
  color: #e6eaf6;
  font-size: 12px;
  line-height: 1.5;
}

.evidence-body p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.8;
  overflow-wrap: anywhere;
}

.evidence-body a {
  display: inline-block;
  margin-top: 11px;
  font-size: 10px;
  font-weight: 650;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 14px 2px 5px;
  color: var(--subtle);
  font-size: 9px;
}

@media (min-width: 1500px) {
  .content {
    padding-right: 52px;
    padding-left: 52px;
  }

  .panel {
    padding: 25px;
  }
}

@media (max-width: 1050px) {
  .sidebar {
    width: 220px;
    min-width: 220px;
  }

  .content {
    padding: 28px 22px;
  }

  .research-layout {
    grid-template-columns: 1fr;
  }

  .empty-state {
    min-height: 230px;
  }
}

@media (max-width: 720px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    width: 100%;
    min-width: 0;
    min-height: auto;
    padding: 13px 15px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    padding: 2px 4px 12px;
  }

  .sidebar > .side-label,
  .sidebar > .nav-item,
  .history-list,
  .sidebar-bottom {
    display: none;
  }

  .topbar {
    height: 53px;
    padding: 0 17px;
  }

  .live-indicator {
    font-size: 8px;
  }

  .content {
    padding: 25px 15px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .page-heading h1 {
    font-size: 24px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .stat-card {
    min-height: 105px;
    padding: 13px;
  }

  .stat-card > strong {
    font-size: 24px;
  }

  .panel {
    padding: 16px;
  }

  .overview-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer {
    flex-direction: column;
    line-height: 1.6;
  }

  .tabs {
    gap: 17px;
    overflow-x: auto;
  }

  .tab {
    flex-shrink: 0;
  }
}

@media (max-width: 390px) {
  .topbar-right {
    gap: 10px;
  }

  .live-indicator {
    letter-spacing: .3px;
  }

  .overview-grid {
    grid-template-columns: 1fr 1fr;
  }

  .execution-metrics small {
    font-size: 8px;
  }
}

/* ================================
   ZETHETA AUTHENTICATION PAGES
================================ */

.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(136, 112, 245, 0.13), transparent 55%),
    var(--bg);
}

.auth-card {
  width: 100%;
  max-width: 440px;
  padding: 38px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
}

.auth-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  color: var(--text);
  font-size: 23px;
  font-weight: 750;
  text-decoration: none;
  margin-bottom: 34px;
}

.auth-brand-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: linear-gradient(135deg, var(--accent), #6048d9);
  color: white;
  font-size: 22px;
  font-weight: 800;
}

.auth-heading {
  text-align: center;
  margin-bottom: 28px;
}

.auth-heading h1 {
  color: var(--text);
  font-size: 27px;
  font-weight: 700;
  letter-spacing: -0.7px;
  margin: 0 0 9px;
}

.auth-heading p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
  margin: 0;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.auth-form label {
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
  margin-top: 7px;
}

.auth-form input {
  width: 100%;
  min-height: 46px;
  padding: 0 14px;
  color: var(--text);
  background: var(--sidebar);
  border: 1px solid var(--border);
  border-radius: 9px;
  outline: none;
  font: inherit;
  font-size: 14px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.auth-form input::placeholder {
  color: var(--subtle);
}

.auth-form input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.auth-form button {
  width: 100%;
  min-height: 47px;
  margin-top: 13px;
  border: none;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--accent), #7056e8);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.2s;
}

.auth-form button:hover:not(:disabled) {
  transform: translateY(-1px);
  opacity: 0.92;
}

.auth-form button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.auth-error {
  padding: 11px 13px;
  border: 1px solid rgba(241, 125, 139, 0.3);
  border-radius: 8px;
  background: rgba(241, 125, 139, 0.08);
  color: var(--red);
  font-size: 13px;
  line-height: 1.5;
}

.auth-footer {
  margin: 25px 0 0;
  color: var(--muted);
  font-size: 13px;
  text-align: center;
}

.auth-footer a {
  color: var(--accent-bright);
  font-weight: 650;
  text-decoration: none;
}

.auth-footer a:hover {
  text-decoration: underline;
}

.auth-back {
  display: block;
  margin-top: 22px;
  color: var(--subtle);
  font-size: 12px;
  text-align: center;
  text-decoration: none;
}

.auth-back:hover {
  color: var(--text);
}

@media (max-width: 480px) {
  .auth-page {
    padding: 20px 14px;
  }

  .auth-card {
    padding: 27px 21px;
  }

  .auth-heading h1 {
    font-size: 24px;
  }
}


.auth-primary-link {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 47px;
  width: 100%;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--accent), #7056e8);
  color: white;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
}

/* =========================================
   ZETHETA — FINANCIAL TERMINAL REDESIGN
   Fiscal.ai-inspired visual styling
========================================= */

:root {
  --bg: #f6f8fb;
  --sidebar: #ffffff;
  --surface: #ffffff;
  --surface-raised: #f8fafc;
  --surface-hover: #f1f5f9;
  --border: #e2e8f0;
  --border-soft: #edf1f6;
  --text: #172033;
  --muted: #64748b;
  --subtle: #94a3b8;
  --accent: #635bdb;
  --accent-bright: #635bdb;
  --accent-soft: #f0efff;
  --green: #15966b;
  --amber: #c18424;
  --red: #dc5263;
  --blue: #3478c9;
}

html,
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-geist-sans), Arial, Helvetica, sans-serif;
}

body {
  font-size: 13px;
}

.app-shell {
  background: #f6f8fb;
}

.sidebar {
  background: #ffffff;
  border-right: 1px solid #e6eaf0;
  padding: 25px 16px 18px;
}

.brand {
  padding-bottom: 34px;
}

.brand-mark {
  width: 37px;
  height: 37px;
  border-radius: 10px;
  background: linear-gradient(145deg, #766cf0, #5146c8);
  box-shadow: 0 4px 12px rgba(99, 91, 219, .18);
}

.brand strong {
  color: #172033;
  font-size: 20px;
  letter-spacing: -.8px;
}

.brand small {
  color: #8994a7;
  font-size: 8px;
}

.side-label {
  color: #9aa4b5;
  font-size: 9px;
  letter-spacing: 1.2px;
}

.nav-item {
  min-height: 40px;
  color: #596579;
  border-radius: 7px;
  font-size: 12px;
}

.nav-item:hover {
  color: #292e45;
  background: #f5f6fa;
}

.nav-item.active {
  color: #5146c8;
  background: #f0efff;
  border-color: #e6e3ff;
}

.nav-icon {
  color: #6b61d8;
}

.history-item {
  color: #536176;
}

.history-item:hover,
.history-item.selected {
  background: #f7f8fc;
  border-color: #e5e9f0;
}

.history-title {
  color: #465268;
}

.empty-history {
  color: #929daf;
}

.connection-card {
  background: #f8fafc;
  border-color: #e5eaf1;
}

.connection-card strong {
  color: #344054;
}

.connection-card small {
  color: #7c8799;
}

.version-label {
  color: #a0a9b8;
}

.topbar {
  height: 62px;
  padding: 0 38px;
  background: rgba(255, 255, 255, .94);
  border-bottom: 1px solid #e8ecf2;
}

.breadcrumb {
  color: #7a8699;
  font-size: 11px;
}

.breadcrumb span {
  color: #b2bac7;
}

.live-indicator {
  color: #64748b;
}

.avatar {
  border: 1px solid #e1defb;
  background: #f0efff;
  color: #5d54cb;
}

.content {
  max-width: 1550px;
  padding: 34px 40px 25px;
}

.eyebrow {
  color: #7168d9;
  font-size: 9px;
  letter-spacing: 1.3px;
}

.page-heading {
  margin-bottom: 25px;
}

.page-heading h1 {
  color: #182235;
  font-size: clamp(25px, 2.4vw, 30px);
  font-weight: 650;
  letter-spacing: -1.15px;
}

.page-heading p {
  color: #778397;
  font-size: 12px;
}

.date-chip {
  background: #ffffff;
  border-color: #e3e8ef;
  color: #536176;
}

.date-chip span {
  color: #6b61d8;
}

.stat-card,
.panel {
  background: #ffffff;
  border: 1px solid #e5eaf1;
  border-radius: 9px;
  box-shadow: 0 2px 8px rgba(25, 39, 65, .025);
}

.stat-card {
  min-height: 108px;
  padding: 17px 18px;
}

.stat-top {
  color: #778397;
  font-size: 10px;
}

.stat-symbol {
  color: #7168d9;
}

.stat-card > strong {
  color: #1c2739;
  font-size: 26px;
  font-weight: 650;
}

.stat-card > small {
  color: #98a2b2;
}

.panel {
  padding: 22px;
}

.panel-heading h2,
.results-heading h2 {
  color: #202b3d;
  font-size: 15px;
  font-weight: 650;
}

.panel-icon {
  border-color: #e5e2ff;
  background: #f3f2ff;
  color: #6b61d8;
}

.panel-description {
  color: #7b8799;
  font-size: 11px;
}

.new-research-panel label {
  color: #465268;
}

.new-research-panel input,
.new-research-panel textarea {
  background: #ffffff;
  border-color: #dce3ec;
  color: #202b3d;
  border-radius: 7px;
  font-size: 11px;
}

.new-research-panel input::placeholder,
.new-research-panel textarea::placeholder {
  color: #a1aaba;
}

.new-research-panel input:focus,
.new-research-panel textarea:focus {
  border-color: #8178e8;
  box-shadow: 0 0 0 3px rgba(99, 91, 219, .09);
}

.input-footer {
  color: #929daf;
}

.primary-button {
  min-height: 43px;
  border: 1px solid #6258d2;
  border-radius: 7px;
  background: #6258d2;
  color: #ffffff;
  box-shadow: 0 3px 8px rgba(99, 91, 219, .14);
}

.primary-button:hover:not(:disabled) {
  background: #5147c3;
  filter: none;
}

.source-note {
  border-top-color: #edf0f5;
}

.source-note > strong {
  color: #536176;
}

.source-tags span {
  background: #f8f9fc;
  border-color: #e6eaf1;
  color: #68758a;
}

.status {
  background: #f6f8fb;
  border-color: #e5eaf1;
  color: #64748b;
}

.status.completed {
  background: #eaf8f1;
  color: #16865f;
}

.status.partial {
  background: #fff7e9;
  color: #b7791f;
}

.status.failed {
  background: #fff0f1;
  color: #cf4658;
}

.status.running {
  background: #edf5ff;
  color: #3478c9;
}

.empty-state h3 {
  color: #344054;
}

.empty-state p {
  color: #8792a4;
}

.empty-icon {
  border-color: #e4e1ff;
  background: #f2f1ff;
  color: #7168d9;
}

.selected-company {
  background: #f8fafc;
  border-color: #e6eaf1;
}

.company-avatar {
  border-color: #e1defb;
  background: #f0efff;
  color: #5d54cb;
}

.selected-company strong {
  color: #263247;
}

.selected-company small {
  color: #7d899c;
}

.research-question {
  background: #f8f7ff;
  border-left-color: #756be0;
}

.research-question small,
.overview-grid small {
  color: #7168d9;
}

.research-question p {
  color: #536176;
}

.timeline-row strong {
  color: #354156;
}

.timeline-row small {
  color: #8a95a6;
}

.timeline-dot {
  background: #f7f8fb;
  border-color: #dce3ec;
  color: #8792a4;
}

.timeline-dot.done {
  background: #eaf8f1;
  border-color: #c9ecdc;
  color: #16865f;
}

.timeline-row:not(:last-child)::after {
  background: #e1e6ee;
}

.execution-metrics {
  border-top-color: #edf0f5;
}

.execution-metrics > div + div {
  border-left-color: #e7ebf1;
}

.execution-metrics strong {
  color: #263247;
}

.execution-metrics small {
  color: #8792a4;
}

.polling-note {
  color: #3478c9;
}

.error-message {
  background: #fff3f4;
  border-color: #f4d4d9;
  color: #c84759;
}

.results-panel {
  padding: 22px;
}

.download-button {
  border-color: #e2dfff;
  background: #f3f2ff;
  color: #5e54c9;
}

.download-button:hover {
  background: #e9e7ff;
}

.tabs {
  border-bottom-color: #e6eaf1;
}

.tab {
  color: #8792a4;
}

.tab:hover {
  color: #343e53;
}

.tab.active-tab {
  color: #5e54c9;
}

.tab.active-tab::after {
  background: #7168d9;
}

.results-empty {
  color: #8792a4;
}

.overview-message {
  background: #f8f9fc;
  border-color: #e6eaf1;
}

.overview-icon {
  background: #efeeff;
  color: #6b61d8;
}

.overview-message h3 {
  color: #344054;
}

.overview-message p {
  color: #788599;
}

.overview-grid > div {
  background: #fafbfc;
  border-color: #e6eaf1;
}

.overview-grid strong {
  color: #344054;
}

.report-title {
  background: #f8f9fc;
  border-color: #e6eaf1;
}

.report-title > span {
  color: #6b61d8;
}

.report-title h3 {
  color: #263247;
}

.report-title small {
  color: #7c8799;
}

.report-content pre {
  background: #fafbfc;
  border-color: #e6eaf1;
  color: #465268;
  font-family: var(--font-geist-mono), monospace;
  font-size: 11px;
}

.evidence-card {
  background: #fafbfc;
  border-color: #e6eaf1;
}

.evidence-number {
  color: #756bd5;
}

.evidence-type {
  color: #6b61d8;
}

.evidence-body h3 {
  color: #344054;
}

.evidence-body p {
  color: #788599;
}

.evidence-body a {
  color: #5e54c9;
}

.footer {
  color: #929daf;
}

/* Authentication pages */

.auth-page {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(99, 91, 219, .07), transparent 55%),
    #f6f8fb;
}

.auth-card {
  background: #ffffff;
  border-color: #e5eaf1;
  box-shadow: 0 15px 50px rgba(25, 39, 65, .07);
}

.auth-brand {
  color: #202b3d;
}

.auth-heading h1 {
  color: #202b3d;
}

.auth-heading p {
  color: #788599;
}

.auth-form label {
  color: #465268;
}

.auth-form input {
  background: #ffffff;
  border-color: #dce3ec;
  color: #202b3d;
}

.auth-form input::placeholder {
  color: #a1aaba;
}

.auth-footer {
  color: #788599;
}

.auth-back {
  color: #8792a4;
}

.auth-error {
  background: #fff3f4;
  border-color: #f4d4d9;
  color: #c84759;
}

@media (max-width: 1050px) {
  .content {
    padding: 28px 22px;
  }
}

@media (max-width: 720px) {
  .sidebar {
    background: #ffffff;
    border-bottom-color: #e6eaf1;
  }

  .topbar {
    background: #ffffff;
  }

  .content {
    padding: 24px 15px;
  }
}


/* =========================================================
   ZETHETA PUBLIC MARKETING HOMEPAGE
   Scoped styles: do not affect dashboard or auth pages.
   ========================================================= */

.marketing-page {
  --m-ink: #172039;
  --m-muted: #68738b;
  --m-purple: #6956d9;
  --m-purple-dark: #4d3bb6;
  --m-line: #e8eaf2;
  min-height: 100vh;
  overflow: hidden;
  background: #f8f9fc;
  color: var(--m-ink);
  font-family: var(--font-geist-sans), Arial, sans-serif;
}

.marketing-page a {
  color: inherit;
  text-decoration: none;
}

.marketing-container {
  width: min(1160px, calc(100% - 64px));
  margin: 0 auto;
}

.marketing-header {
  position: relative;
  z-index: 20;
  background: rgba(255, 255, 255, .94);
  border-bottom: 1px solid rgba(225, 228, 239, .8);
}

.marketing-nav {
  width: min(1240px, calc(100% - 64px));
  height: 82px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.marketing-brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  flex-shrink: 0;
  color: #202943 !important;
}

.marketing-brand-mark {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: #fff;
  font-size: 23px;
  font-weight: 800;
  background: linear-gradient(145deg, #a18aff, #6247d5);
  box-shadow: 0 5px 17px rgba(105, 86, 217, .23);
}

.marketing-brand strong {
  display: block;
  font-size: 20px;
  line-height: 1;
  letter-spacing: -.8px;
  font-weight: 800;
}

.marketing-brand small {
  display: block;
  margin-top: 5px;
  color: #8b91a4;
  font-size: 8px;
  letter-spacing: 1.4px;
  font-weight: 750;
}

.marketing-nav-links {
  display: flex;
  align-items: center;
  gap: 35px;
  height: 100%;
  color: #515b72;
  font-size: 13px;
  font-weight: 600;
}

.marketing-nav-links > a,
.marketing-dropdown > summary {
  transition: color .2s ease;
}

.marketing-nav-links > a:hover,
.marketing-dropdown > summary:hover {
  color: var(--m-purple);
}

.marketing-dropdown {
  position: relative;
}

.marketing-dropdown summary {
  display: flex;
  align-items: center;
  gap: 7px;
  list-style: none;
  cursor: pointer;
}

.marketing-dropdown summary::-webkit-details-marker {
  display: none;
}

.marketing-dropdown summary span {
  color: #9399aa;
  font-size: 16px;
}

.marketing-dropdown-panel {
  position: absolute;
  top: 34px;
  left: -20px;
  width: 245px;
  padding: 9px;
  border: 1px solid #e7e8f0;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 18px 45px rgba(30, 37, 66, .13);
}

.marketing-dropdown-panel a {
  display: block;
  padding: 11px 12px;
  border-radius: 8px;
  color: #515b72;
  font-size: 12px;
}

.marketing-dropdown-panel a:hover {
  background: #f4f2ff;
  color: var(--m-purple-dark);
}

.marketing-nav-actions {
  display: flex;
  align-items: center;
  gap: 23px;
  flex-shrink: 0;
}

.marketing-login {
  color: #4c566e !important;
  font-size: 13px;
  font-weight: 650;
}

.marketing-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 17px;
  min-height: 52px;
  padding: 0 23px;
  border: 1px solid var(--m-purple);
  border-radius: 9px;
  background: linear-gradient(120deg, #7868e8, #5e4bc8);
  color: #fff !important;
  box-shadow: 0 8px 22px rgba(105, 86, 217, .2);
  font-size: 13px;
  font-weight: 700;
  transition: transform .2s ease, box-shadow .2s ease;
}

.marketing-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 27px rgba(105, 86, 217, .28);
}

.marketing-button span {
  font-size: 17px;
}

.marketing-button-small {
  min-height: 41px;
  padding: 0 16px;
  gap: 10px;
  font-size: 12px;
}

.marketing-hero {
  position: relative;
  min-height: 650px;
  padding: 80px 0 0;
  background:
    radial-gradient(ellipse at 77% 42%, rgba(177, 164, 255, .2), transparent 36%),
    linear-gradient(115deg, #fbfbfe 0%, #f5f4ff 53%, #f8f9fd 100%);
}

.marketing-hero-glow {
  position: absolute;
  top: 80px;
  right: 7%;
  width: 490px;
  height: 490px;
  border-radius: 50%;
  background: rgba(164, 148, 255, .11);
  filter: blur(70px);
  pointer-events: none;
}

.marketing-hero-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 65px;
}

.marketing-hero-copy {
  padding: 14px 0 50px;
}

.marketing-eyebrow,
.marketing-section-label {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #786bd0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.marketing-eyebrow {
  padding: 10px 13px;
  border: 1px solid #e6e0ff;
  border-radius: 30px;
  background: rgba(255, 255, 255, .72);
}

.marketing-eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #7968e3;
  box-shadow: 0 0 0 4px rgba(121, 104, 227, .1);
}

.marketing-hero h1 {
  margin: 28px 0 22px;
  color: #19223b;
  font-size: clamp(43px, 5.1vw, 66px);
  line-height: 1.08;
  letter-spacing: -3.4px;
  font-weight: 780;
}

.marketing-hero h1 span,
.marketing-intro h2 span,
.marketing-section-heading h2 span,
.marketing-how h2 span {
  color: var(--m-purple);
}

.marketing-hero-description {
  max-width: 510px;
  margin: 0;
  color: #68738b;
  font-size: 15px;
  line-height: 1.9;
}

.marketing-hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 25px;
  margin-top: 32px;
}

.marketing-secondary-link {
  color: #59637a !important;
  font-size: 12px;
  font-weight: 700;
}

.marketing-secondary-link span {
  margin-left: 7px;
  color: var(--m-purple);
}

.marketing-hero-note {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 35px;
  color: #8991a4;
  font-size: 11px;
}

.marketing-hero-note span {
  color: var(--m-purple);
  font-size: 16px;
}

.marketing-visual-wrap {
  position: relative;
  min-height: 455px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.marketing-orbit {
  position: absolute;
  border: 1px solid rgba(127, 110, 221, .15);
  border-radius: 50%;
  pointer-events: none;
}

.marketing-orbit-one {
  width: 460px;
  height: 460px;
}

.marketing-orbit-two {
  width: 375px;
  height: 375px;
  border-style: dashed;
}

.marketing-visual-card {
  position: relative;
  z-index: 2;
  width: min(100%, 430px);
  overflow: hidden;
  border: 1px solid #e4e4f0;
  border-radius: 16px;
  background: rgba(255, 255, 255, .96);
  box-shadow:
    0 30px 75px rgba(49, 42, 104, .13),
    0 5px 15px rgba(49, 42, 104, .04);
  transform: rotate(-2deg);
}

.visual-card-top {
  height: 47px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 17px;
  border-bottom: 1px solid #eeeef5;
  background: #fcfcff;
  color: #969bb0;
  font-size: 8px;
  letter-spacing: 1.1px;
  font-weight: 800;
}

.visual-window-dots {
  display: flex;
  gap: 4px;
}

.visual-window-dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d7d5e5;
}

.visual-live {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #6d9e88;
}

.visual-live i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #65b68c;
}

.visual-card-content {
  padding: 23px 22px 15px;
}

.visual-welcome {
  display: flex;
  align-items: center;
  gap: 12px;
}

.visual-sparkle {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #f0edff;
  color: #7665d8;
  font-size: 19px;
}

.visual-welcome small,
.visual-floating small {
  display: block;
  margin-bottom: 5px;
  color: #9a9eb0;
  font-size: 8px;
  letter-spacing: 1px;
  font-weight: 750;
}

.visual-welcome strong {
  display: block;
  color: #303950;
  font-size: 12px;
}

.visual-prompt {
  min-height: 51px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 22px;
  padding: 0 11px 0 14px;
  border: 1px solid #e8e6f3;
  border-radius: 8px;
  color: #9a9fb0;
  font-size: 10px;
}

.visual-send {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 7px;
  background: #7160d6;
  color: white;
  font-size: 15px;
}

.visual-divider {
  height: 1px;
  margin: 23px 0 18px;
  background: #eeeef4;
}

.visual-section-label {
  color: #9a9fb0;
  font-size: 8px;
  letter-spacing: 1.2px;
  font-weight: 800;
}

.visual-capability {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f5;
}

.visual-capability-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #f4f1ff;
  color: #7665d8;
  font-size: 16px;
}

.visual-capability strong,
.visual-capability small {
  display: block;
}

.visual-capability strong {
  color: #39435b;
  font-size: 10px;
}

.visual-capability small {
  margin-top: 4px;
  color: #a0a5b5;
  font-size: 9px;
}

.visual-arrow {
  margin-left: auto;
  color: #9990d5;
  font-size: 14px;
}

.visual-card-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 14px;
  color: #a1a5b4;
  font-size: 8px;
}

.visual-card-footer span:last-child {
  color: #796bd0;
  font-weight: 800;
  letter-spacing: 1px;
}

.visual-floating {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 15px;
  border: 1px solid #eceaf5;
  border-radius: 11px;
  background: white;
  box-shadow: 0 13px 32px rgba(43, 39, 83, .1);
}

.visual-floating > span {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #f0edff;
  color: #7767d8;
}

.visual-floating strong {
  display: block;
  color: #3b455c;
  font-size: 10px;
}

.visual-floating-top {
  top: 37px;
  right: -12px;
}

.visual-floating-bottom {
  bottom: 30px;
  left: -23px;
}

.marketing-hero-bottom {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  min-height: 65px;
  margin-top: 27px;
  border-top: 1px solid rgba(220, 220, 237, .8);
  color: #9a9eb0;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 2px;
}

.marketing-hero-bottom i {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #a99de9;
}

.marketing-intro {
  padding: 105px 0;
  background: #fff;
}

.marketing-intro-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: end;
  gap: 100px;
}

.marketing-intro h2,
.marketing-section-heading h2,
.marketing-how h2 {
  margin: 18px 0 0;
  color: #202a43;
  font-size: clamp(32px, 4vw, 45px);
  line-height: 1.2;
  letter-spacing: -1.9px;
  font-weight: 760;
}

.marketing-intro-grid > p {
  margin: 0 0 4px;
  color: #707a90;
  font-size: 14px;
  line-height: 1.95;
}

.marketing-products {
  padding: 105px 0 120px;
  background:
    radial-gradient(ellipse at 85% 45%, rgba(189, 180, 255, .15), transparent 35%),
    #f6f7fc;
}

.marketing-section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 50px;
  margin-bottom: 55px;
}

.marketing-section-heading h2 {
  max-width: 590px;
}

.marketing-section-heading > p {
  max-width: 320px;
  margin: 0 0 5px;
  color: #7b8499;
  font-size: 13px;
  line-height: 1.8;
}

.marketing-product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  gap: 24px;
}

.marketing-product-card {
  position: relative;
  min-height: 300px;
  display: flex;
  flex-direction: column;
  padding: 26px;
  overflow: hidden;
  border: 1px solid #e8e8f1;
  border-radius: 15px;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 9px 28px rgba(40, 45, 83, .035);
  transition: transform .25s ease, box-shadow .25s ease;
}

.marketing-product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 17px 38px rgba(40, 45, 83, .09);
}

.product-card-primary {
  min-height: 330px;
  border-color: #ded9fa;
  background: linear-gradient(145deg, #fff 50%, #f2efff);
}

.product-card-offset {
  margin-top: 48px;
}

.product-card-lower {
  margin-top: -28px;
}

.product-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-number {
  color: #a0a4b5;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.product-symbol {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid #e8e4fa;
  border-radius: 12px;
  background: #f5f2ff;
  color: #7666d6;
  font-size: 21px;
}

.product-card-body {
  margin-top: 22px;
}

.product-card-body h3 {
  margin: 0;
  color: #28334d;
  font-size: 20px;
  letter-spacing: -.55px;
}

.product-card-body p {
  max-width: 440px;
  margin: 12px 0 17px;
  color: #7a8499;
  font-size: 12px;
  line-height: 1.85;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.product-tags span {
  padding: 7px 9px;
  border: 1px solid #ecebf3;
  border-radius: 6px;
  background: #fafaff;
  color: #777f95;
  font-size: 9px;
  font-weight: 650;
}

.product-card-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 22px;
  color: #6859c7 !important;
  font-size: 11px;
  font-weight: 750;
}

.product-card-link span {
  font-size: 16px;
}

.marketing-how {
  padding: 115px 0;
  background: #fff;
}

.marketing-how-grid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 100px;
}

.marketing-how-heading {
  padding-top: 12px;
}

.marketing-how-heading > p {
  max-width: 360px;
  margin: 21px 0 26px;
  color: #778197;
  font-size: 13px;
  line-height: 1.9;
}

.marketing-text-link {
  display: inline-flex;
  gap: 12px;
  color: #6859c7 !important;
  font-size: 12px;
  font-weight: 750;
}

.marketing-steps {
  border-top: 1px solid #e9eaf1;
}

.marketing-step {
  display: grid;
  grid-template-columns: 36px 43px 1fr 20px;
  align-items: start;
  gap: 17px;
  padding: 27px 0;
  border-bottom: 1px solid #e9eaf1;
}

.step-number {
  padding-top: 8px;
  color: #9b9eaf;
  font-size: 10px;
  font-weight: 800;
}

.step-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #f2efff;
  color: #7565d4;
  font-size: 19px;
}

.step-copy h3 {
  margin: 1px 0 8px;
  color: #303b54;
  font-size: 15px;
}

.step-copy p {
  max-width: 420px;
  margin: 0;
  color: #80899c;
  font-size: 11px;
  line-height: 1.8;
}

.step-arrow {
  padding-top: 8px;
  color: #9b91d8;
  font-size: 16px;
}

.marketing-cta {
  padding: 35px 0 105px;
  background: #fff;
}

.marketing-cta-panel {
  position: relative;
  min-height: 350px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 50px 25px;
  border-radius: 19px;
  background:
    radial-gradient(circle at 85% 10%, rgba(171, 153, 255, .3), transparent 30%),
    linear-gradient(115deg, #242044, #342b69 60%, #40347e);
  text-align: center;
}

.marketing-cta-panel .marketing-section-label {
  position: relative;
  z-index: 1;
  color: #c4baff;
}

.marketing-cta-panel h2 {
  position: relative;
  z-index: 1;
  margin: 20px 0 13px;
  color: white;
  font-size: clamp(34px, 4.4vw, 48px);
  line-height: 1.12;
  letter-spacing: -1.9px;
}

.marketing-cta-panel > p {
  position: relative;
  z-index: 1;
  max-width: 480px;
  margin: 0 0 25px;
  color: #d0cde4;
  font-size: 12px;
  line-height: 1.8;
}

.marketing-button-light {
  position: relative;
  z-index: 1;
  border-color: #fff;
  background: #fff;
  color: #5545b2 !important;
  box-shadow: none;
}

.marketing-button-light:hover {
  box-shadow: 0 10px 25px rgba(0, 0, 0, .15);
}

.cta-decoration {
  position: absolute;
  border: 1px solid rgba(215, 207, 255, .13);
  border-radius: 50%;
  pointer-events: none;
}

.cta-decoration-one {
  width: 390px;
  height: 390px;
  top: -220px;
  left: -90px;
}

.cta-decoration-two {
  width: 470px;
  height: 470px;
  right: -190px;
  bottom: -300px;
}

.marketing-footer {
  padding: 55px 0 22px;
  background: #f8f9fc;
}

.marketing-footer-main {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 80px;
  padding-bottom: 45px;
}

.marketing-footer-brand p {
  max-width: 310px;
  margin: 18px 0 0;
  color: #858da0;
  font-size: 11px;
  line-height: 1.9;
}

.marketing-footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
}

.marketing-footer-column strong {
  margin-bottom: 5px;
  color: #37415a;
  font-size: 11px;
}

.marketing-footer-column a {
  color: #81899c !important;
  font-size: 11px;
  transition: color .2s ease;
}

.marketing-footer-column a:hover {
  color: var(--m-purple) !important;
}

.marketing-footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-top: 20px;
  border-top: 1px solid #e8eaf1;
  color: #9a9fb0;
  font-size: 10px;
}

/* Responsive marketing homepage */

@media (max-width: 1000px) {
  .marketing-nav-links {
    gap: 20px;
  }

  .marketing-hero-grid {
    gap: 30px;
  }

  .marketing-hero h1 {
    font-size: 52px;
  }

  .marketing-how-grid {
    gap: 55px;
  }

  .marketing-intro-grid {
    gap: 55px;
  }
}

@media (max-width: 760px) {
  .marketing-container,
  .marketing-nav {
    width: min(100% - 36px, 560px);
  }

  .marketing-nav {
    height: 70px;
    gap: 12px;
  }

  .marketing-nav-links {
    display: none;
  }

  .marketing-nav-actions {
    gap: 13px;
  }

  .marketing-login {
    font-size: 12px;
  }

  .marketing-button-small {
    min-height: 37px;
    padding: 0 11px;
    font-size: 10px;
  }

  .marketing-brand-mark {
    width: 35px;
    height: 35px;
  }

  .marketing-brand strong {
    font-size: 18px;
  }

  .marketing-hero {
    padding-top: 65px;
  }

  .marketing-hero-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .marketing-hero-copy {
    padding-bottom: 10px;
  }

  .marketing-hero h1 {
    font-size: clamp(42px, 10vw, 57px);
    letter-spacing: -2.5px;
  }

  .marketing-hero-description {
    font-size: 13px;
  }

  .marketing-visual-wrap {
    min-height: 430px;
    margin: 10px 0 0;
  }

  .marketing-visual-card {
    width: min(90%, 430px);
  }

  .marketing-orbit-one {
    width: 390px;
    height: 390px;
  }

  .marketing-orbit-two {
    width: 320px;
    height: 320px;
  }

  .visual-floating-top {
    right: 0;
  }

  .visual-floating-bottom {
    left: 0;
  }

  .marketing-hero-bottom {
    gap: 13px;
    font-size: 8px;
    letter-spacing: 1px;
  }

  .marketing-intro,
  .marketing-products,
  .marketing-how {
    padding: 75px 0;
  }

  .marketing-intro-grid,
  .marketing-how-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .marketing-intro h2,
  .marketing-section-heading h2,
  .marketing-how h2 {
    font-size: 35px;
  }

  .marketing-intro-grid > p {
    font-size: 13px;
  }

  .marketing-section-heading {
    display: block;
    margin-bottom: 35px;
  }

  .marketing-section-heading > p {
    margin-top: 16px;
  }

  .marketing-product-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .marketing-product-card,
  .product-card-primary {
    min-height: 285px;
  }

  .product-card-offset,
  .product-card-lower {
    margin-top: 0;
  }

  .marketing-steps {
    margin-top: 10px;
  }

  .marketing-step {
    grid-template-columns: 25px 38px 1fr 15px;
    gap: 10px;
  }

  .step-icon {
    width: 36px;
    height: 36px;
  }

  .marketing-cta {
    padding: 10px 0 70px;
  }

  .marketing-cta-panel {
    min-height: 330px;
    padding: 35px 18px;
  }

  .marketing-cta-panel h2 {
    font-size: 37px;
  }

  .marketing-footer-main {
    grid-template-columns: 1fr 1fr;
    gap: 35px 20px;
  }

  .marketing-footer-brand {
    grid-column: 1 / -1;
  }

  .marketing-footer-bottom {
    flex-direction: column;
    gap: 10px;
  }
}

@media (max-width: 390px) {
  .marketing-nav {
    width: calc(100% - 24px);
  }

  .marketing-nav-actions {
    gap: 9px;
  }

  .marketing-brand {
    gap: 7px;
  }

  .marketing-brand small {
    font-size: 7px;
    letter-spacing: .9px;
  }

  .marketing-button-small {
    padding: 0 8px;
  }

  .marketing-hero h1 {
    font-size: 39px;
  }

  .visual-floating {
    padding: 9px;
  }
}
